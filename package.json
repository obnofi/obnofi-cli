{
  "name": "obnofi-cli",
  "version": "1.2.0",
  "description": "Obnofi CLI",
  "main": "index.js",
  "bin": {
    "obnofi": "index.js"
  },
  "files": [
    "index.js",
    "config.js",
    "splash.js",
    "commands",
    "assets",
    "README.md"
  ],
  "scripts": {
    "start": "node index.js",
    "check": "node -c index.js && node -c config.js && node -c splash.js && node -c commands/auth.js && node -c commands/note.js && node -c commands/db.js && node -c commands/feed.js",
    "smoke": "OBNOFI_CONFIG_DIR=/tmp/obnofi-cli-smoke node index.js --help",
    "pack:check": "npm_config_cache=/tmp/obnofi-cli-npm-cache npm pack --dry-run",
    "prepublishOnly": "npm run check && npm run smoke && npm run pack:check",
    "release:patch": "npm version patch && npm_config_cache=/tmp/obnofi-cli-npm-cache npm publish",
    "release:minor": "npm version minor && npm_config_cache=/tmp/obnofi-cli-npm-cache npm publish",
    "release:major": "npm version major && npm_config_cache=/tmp/obnofi-cli-npm-cache npm publish"
  },
  "keywords": [
    "cli",
    "obnofi"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.7.2",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "inquirer": "^8.2.6",
    "open": "^10.1.0",
    "ora": "^5.4.1",
    "sharp": "^0.33.5"
  }
}
