{
  "name": "obnofi-cli",
  "version": "2.0.1",
  "description": "Obnofi CLI",
  "main": "index.js",
  "bin": {
    "obnofi": "index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obnofi/obnofi-cli.git"
  },
  "homepage": "https://github.com/obnofi/obnofi-cli#readme",
  "bugs": {
    "url": "https://github.com/obnofi/obnofi-cli/issues"
  },
  "files": [
    "index.js",
    "config.js",
    "splash.js",
    "commands",
    "assets",
    "README.md"
  ],
  "scripts": {
    "start": "node index.js",
    "check": "node -c index.js && node -c config.js && node -c splash.js && node -c commands/auth.js && node -c commands/note.js && node -c commands/db.js && node -c commands/feed.js",
    "smoke": "OBNOFI_CONFIG_DIR=/tmp/obnofi-cli-smoke node index.js --help",
    "pack:check": "npm_config_cache=/tmp/obnofi-cli-npm-cache npm pack --dry-run",
    "prepublishOnly": "npm run check && npm run smoke && npm run pack:check",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "keywords": [
    "cli",
    "obnofi"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "inquirer": "^8.2.6",
    "open": "^10.1.0",
    "ora": "^5.4.1",
    "sharp": "^0.33.5"
  }
}
